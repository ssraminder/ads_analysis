# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/adscraper
DATABASE_ASYNC_URL=postgresql+asyncpg://user:pass@localhost:5432/adscraper

# Redis
REDIS_URL=redis://localhost:6379/0

# Proxy Providers (optional - leave empty for direct connection)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Scraping Settings
SCRAPE_DELAY_MIN_SECONDS=30
SCRAPE_DELAY_MAX_SECONDS=120
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30

# Rate Limits
MAX_REQUESTS_PER_PROXY_PER_HOUR=30
MAX_CONCURRENT_SCRAPERS=5

# Geo Targeting
DEFAULT_GEO=US
